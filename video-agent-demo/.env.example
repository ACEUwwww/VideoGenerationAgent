# ---------- LLM: DeepSeek (planning, prompts, repair) ----------
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_REASONER_MODEL=deepseek-reasoner
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=4096

# ---------- Media providers: mock | ark ----------
# mock   -> real PNG / real H.264 1080x1920 clip rendered locally, no cost
# ark    -> Volcengine Doubao Seedream (image) + Seedance (video), PAID per call
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
TTS_PROVIDER=mock            # mock | doubao_speech
TTS_API_KEY=                 # Doubao Speech key (openspeech), NOT the Ark key
TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/create
TTS_MODEL=seed-audio-1.0

# ---------- Volcengine Ark ----------
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-20260415
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
# Vision judge for QA. Paid per call, same gate as Seedream/Seedance.
# Leave empty to disable MLLM scoring and keep the measured-only path.
ARK_VISION_MODEL=doubao-seed-2-1-pro-260915
# Ark calls are billed per render. A run refuses to spend money unless this is 1.
# ARK_ALLOW_PAID=1

# ---------- Vertical short-drama canvas ----------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_TRANSITIONS=1           # 1 | 0 — map 叠化/闪白/推黑 onto xfade
VIDEO_TITLE_CARD=1            # 1 | 0 — 1.2s title card before the first shot
BGM_PATH=                     # project-relative or absolute audio file
BGM_VOLUME=0.18

# 480p keeps test renders cheap; use 720p/1080p for production
ARK_VIDEO_RESOLUTION=480p
