# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
*.tsbuildinfo

# Runtime workspace keeps generated demo artifacts.
workspace/projects/*/

# Local env
.env
.env.*
# The template carries no secrets and is what README tells users to copy.
!.env.example

# Test artifacts from smoke scripts.
workspace/projects/_*/

# ---- bench: comparison harness against Video-Bench ----
# Vendored upstream checkout (own .git) and the model weights/caches are
# restored by bench/setup_vendor.py and the HF download, never committed.
bench/_vendor/
bench/models/
bench/.venv/
bench/data/
bench/results/
# The write-up is a paper artifact, not a run output: it is what a reader is
# meant to find, so it is versioned while the renders it cites stay local.
!bench/results/
bench/results/*
!bench/results/tier3a_report.md
# Evidence for the control arm: which claims are measured and which are still
# open. Small text, and the report cites it directly.
!bench/results/om_control_notes.md
# Pixel-side cross-check of the consistency claim: a feasibility result, so the
# write-up is versioned while the frames it describes stay local.
!bench/results/identity_crosscheck.md
# Workflow comparison against OpenMontage and DreamFactory. Documentation only:
# it cites code that is in the tree and a paper, so there is media to exclude.
!bench/results/workflow_comparison.md
# The paper-level write-up: workflow, experiments, figures, and the
# mechanism analysis against the reference workflow.
!bench/results/orchestration_report.md
# Text evidence behind the figures: judge verdicts and render records only.
# The media they describe is tens of MB of renders and stays local.
!bench/results/tier3a_story/
bench/results/tier3a_story/*
!bench/results/tier3a_story/*.json
!bench/results/tier3a_story/*.jsonl
!bench/results/tier3a_ab/
bench/results/tier3a_ab/*
!bench/results/tier3a_ab/*.jsonl
!bench/results/tier3a_ab/judge/
bench/results/tier3a_ab/judge/*
!bench/results/tier3a_ab/judge/*.json
!bench/results/om_control/
bench/results/om_control/*
!bench/results/om_control/*.json
!bench/results/om_control/ours_matched/
bench/results/om_control/ours_matched/*
!bench/results/om_control/ours_matched/*.jsonl
# Repeated-measure study: scores, render records and cached planner output.
# The 78 MB of clips they describe stay local.
!bench/results/tier3a_repeats/
bench/results/tier3a_repeats/*
!bench/results/tier3a_repeats/*.json
!bench/results/tier3a_repeats/*.jsonl
!bench/results/tier3a_repeats/plans/
bench/results/tier3a_repeats/plans/*
!bench/results/tier3a_repeats/plans/*.json
bench/_smoke/
bench/logs/
